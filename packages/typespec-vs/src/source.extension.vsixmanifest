<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="typespec.typespecvs" Version="|%CurrentProject%;GetPackageVersionForVsixManifest|" Language="en-US" Publisher="typespec" />
    <DisplayName>TypeSpec for Visual Studio</DisplayName>
    <Description>TypeSpec language support for Visual Studio</Description>
    <MoreInfo>https://github.com/microsoft/typespec</MoreInfo>
    <License>LICENSE</License>
    <Icon>Icons/logo.png</Icon>
    <Preview>true</Preview>
  </Metadata>
  <Installation ExtensionType="VSSDK+VisualStudio.Extensibility">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <DotnetTargetVersions>net8.0</DotnetTargetVersions>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="typespec.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.ImageManifest" Path="Monikers.imagemanifest" />
  </Assets>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</PackageManifest>
