class {{ prefix }}MetadataLROPoller({{ prefix }}LROPoller[T]):
    """A poller with metadata from the latest received status-monitor response.

    :param client: The pipeline client used for polling.
    :type client: any
    :param initial_response: The initial pipeline response.
    :type initial_response: any
    :param deserialization_callback: Callback for the final result.
    :type deserialization_callback: callable
    :param polling_method: The polling strategy.
    :type polling_method: ~azure.core.polling.{{ prefix }}PollingMethod
    :keyword lro_metadata: Generated metadata selection and deserializers.
    :paramtype lro_metadata: any
    """

    def __init__(
        self, client: Any, initial_response: Any, deserialization_callback: Any,
        polling_method: Any, *, lro_metadata: _LroMetadata,
    ) -> None:
        self._lro_metadata = lro_metadata
        lro_metadata.initialize(initial_response.http_response)
        super().__init__(client, initial_response, deserialization_callback, polling_method)

    @property
    def details(self) -> Mapping[str, Any]:
        """Selected metadata, decoded using the generated model types.

        Absent values are omitted. Values are refreshed after each monitor response,
        including failed or canceled responses. After resuming, the next poll
        repopulates metadata; it is not stored separately in continuation tokens.

        :rtype: Mapping[str, Any]
        :return: The latest received selected metadata and operation ID, when available.
        """
        return self._lro_metadata.details

    @property
    def operation_id(self) -> Optional[str]:
        """The selected server-issued ID, or None until it is available.

        A received body ID takes precedence over the polling URI ID.
        This value is never used as the polling URL.

        :rtype: str or None
        :return: The selected server-issued operation identifier.
        """
        return self._lro_metadata.operation_id

    @classmethod
    def from_continuation_token(
        cls, polling_method: Any, continuation_token: str, **kwargs: Any,
    ) -> "{{ prefix }}MetadataLROPoller[T]":
        """Resume polling, repopulating metadata on the next monitor response.

        :param polling_method: The polling strategy.
        :type polling_method: ~azure.core.polling.{{ prefix }}PollingMethod
        :param str continuation_token: The opaque continuation token.
        :keyword client: The pipeline client.
        :paramtype client: any
        :keyword deserialization_callback: Callback for the final result.
        :paramtype deserialization_callback: callable
        :keyword lro_metadata: Generated metadata selection and deserializers.
        :paramtype lro_metadata: any
        :rtype: ~{{ prefix }}MetadataLROPoller
        :return: The resumed poller.
        """
        metadata = kwargs.pop("lro_metadata")
        metadata.rehydrated = True
        client, initial_response, callback = polling_method.from_continuation_token(continuation_token, **kwargs)
        return cls(client, initial_response, callback, polling_method, lro_metadata=metadata)


