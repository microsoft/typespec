"""Pollers exposing selected status-monitor metadata and operation identity."""

import re
from typing import Any, Callable, Mapping, Optional, TypeVar
from urllib.parse import unquote, urlsplit

from azure.core.polling import AsyncLROPoller, LROPoller
{% if code_model.options["azure-arm"] %}
from azure.mgmt.core.polling.arm_polling import ARMPolling
from azure.mgmt.core.polling.async_arm_polling import AsyncARMPolling
{% else %}
from azure.core.polling.async_base_polling import AsyncLROBasePolling
from azure.core.polling.base_polling import LROBasePolling
{% endif %}

__all__ = ["MetadataLROPoller", "AsyncMetadataLROPoller"]

T = TypeVar("T")
_MISSING = object()


def _read_property(body: Any, path: list[str]) -> Any:
    for segment in path:
        if not isinstance(body, Mapping) or segment not in body:
            return _MISSING
        body = body[segment]
    return body


class _LroMetadata:
    def __init__(
        self,
        status_metadata: Mapping[str, tuple[list[str], Callable[[Any], Any]]],
        *,
        operation_id_path: Optional[list[str]] = None,
        operation_id_uri: Optional[dict[str, str]] = None,
        initial_response_is_monitor: bool = False,
    ) -> None:
        self._status_metadata = status_metadata
        self._operation_id_path = operation_id_path
        self._operation_id_uri = operation_id_uri
        self._initial_response_is_monitor = initial_response_is_monitor
        self._snapshot: tuple[dict[str, Any], Optional[str]] = ({}, None)
        self._uri_id: Optional[str] = None
        self.rehydrated = False

    def initialize(self, response: Any) -> None:
        if self._operation_id_uri:
            source = self._operation_id_uri
            if source["location"] == "ResponseHeader":
                url = response.headers.get(source["property"])
            elif source["location"] == "Self":
                url = response.json() if response.content else None
            else:
                url = _read_property(response.json(), [source["property"]]) if response.content else None
            if isinstance(url, str):
                # Match the modeled route, not the last URL component: IDs may precede a suffix.
                segments = re.split(r"(\{[^}]+\})", source["path"])
                pattern = "".join(
                    "(?P<operation_id>[^/]+)"
                    if segment == "{" + source["parameter"] + "}"
                    else "[^/]+"
                    if segment.startswith("{")
                    else re.escape(segment)
                    for segment in segments
                )
                match = re.search(pattern + r"/?$", urlsplit(url).path)
                self._uri_id = unquote(match.group("operation_id")) if match else None
        if self._initial_response_is_monitor and not self.rehydrated:
            self.update(response)

    def update(self, response: Any) -> None:
        body = response.json() if response.content else {}
        details = {}
        for name, (path, deserialize) in self._status_metadata.items():
            value = _read_property(body, path)
            if value is not _MISSING:
                details[name] = deserialize(value)
        body_id = _read_property(body, self._operation_id_path) if self._operation_id_path else None
        self._snapshot = (details, body_id if isinstance(body_id, str) else None)

    @property
    def operation_id(self) -> Optional[str]:
        body_id = self._snapshot[1]
        return body_id if body_id is not None else self._uri_id

    @property
    def details(self) -> Mapping[str, Any]:
        values, body_id = self._snapshot
        details = values.copy()
        operation_id = body_id if body_id is not None else self._uri_id
        if operation_id is not None:
            details["operation_id"] = operation_id
        return details


